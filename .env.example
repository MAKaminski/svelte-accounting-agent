# Copy to .env and fill in. Never commit .env.
# Google sign-in. Leave AUTH_GOOGLE_ID empty locally for the dev bypass (everyone = owner@local).
# SIGNUP_MODE=open (default): anyone with Google creates a company. invite: invited emails only.
SIGNUP_MODE=open
# Redirect URIs: https://<host>/auth/callback/google and http://localhost:5173/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# openssl rand -base64 32
AUTH_SECRET=
TOKEN_ENC_KEY=
# Users paste their own Slash/Mercury keys in the app (stored encrypted per company).
# These two are only for a single-company self-host that wants a server-wide Slash key.
SLASH_MODE=fixture
SLASH_API_KEY=
SLASH_LEGAL_ENTITY_ID=
# Intuit app (developer.intuit.com). Each company signs in to its own QuickBooks with it.
QBO_MODE=fixture
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:5173/api/qbo/callback
QBO_ENV=sandbox
MODEL_MODE=fixture
ANTHROPIC_API_KEY=
MODEL_WORKER=claude-haiku-5-5
MODEL_INTEGRATOR=claude-sonnet-5-5
OLLAMA_URL=
# Local: in-process Postgres (PGlite). Production: Neon *direct* (non-pooled) endpoint as books_app —
# session settings (app.org_id, role) don't survive PgBouncer transaction pooling.
DATABASE_URL=pglite:data/pglite
# Migrations run as the owner role (Neon only).
DATABASE_URL_OWNER=
# Runtime role; row-level security applies to it. Leave as books_app.
APP_DB_ROLE=books_app
DEFAULT_ORG_ID=org_demo
PULL_INTERVAL_MIN=0
BOOKS_URL=http://localhost:5173
